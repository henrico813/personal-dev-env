#!/usr/bin/env bash
# Keeps the owner's lists that ci/scan blocks: private names under
# private_terms, and topic regexes under private_patterns.
# The lists stay encrypted with sops, and this command never prints them.
#
#   ci/terms edit   # edit the lists, one name or regex per item
#   ci/terms push   # copy them to the PRIVATE_TERMS and PRIVATE_PATTERNS secrets
#
# A regex must work in both Go (RE2) and jq, so it has no lookaround.
set -euo pipefail

terms_file=${PDE_PRIVATE_TERMS_FILE:-$HOME/.config/pde/private-terms.sops.yaml}
age_keys=${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}

case ${1:-} in
edit)
    if [[ ! -e $terms_file ]]; then
        mkdir -p "$(dirname "$terms_file")"
        recipient=$(age-keygen -y "$age_keys")
        # mktemp's file is private, and a failed encrypt leaves no empty list.
        new=$(mktemp "$terms_file.XXXXXX")
        trap 'rm -f "$new"' EXIT
        printf 'private_terms: []\nprivate_patterns: []\n' |
            sops --encrypt --age "$recipient" --input-type yaml \
                --output-type yaml /dev/stdin >"$new"
        mv "$new" "$terms_file"
    fi
    # sops opens $EDITOR on the plain text and encrypts it again on save.
    exec sops "$terms_file"
    ;;
push)
    sops --decrypt --extract '["private_terms"]' --output-type json "$terms_file" |
        jq -r '.[]' | gh secret set PRIVATE_TERMS
    sops --decrypt --extract '["private_patterns"]' --output-type json "$terms_file" |
        jq -r '.[]' | gh secret set PRIVATE_PATTERNS
    ;;
*)
    printf 'usage: terms edit | push\n' >&2
    exit 2
    ;;
esac
