#!/bin/sh
set -eu

[ "${PDE_PROFILE:-}" = "full" ] || exit 0

config_dir="$HOME/.config"
env_dir="$config_dir/vibe"
env_file="$env_dir/goog.env"

ensure_directory() {
    path=$1
    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
        (umask 077 && mkdir "$path") 2>/dev/null || :
    fi
    if [ -L "$path" ]; then
        printf '%s\n' "Vibe environment path is symlinked: $path" >&2
        exit 1
    fi
    if [ ! -d "$path" ]; then
        printf '%s\n' "Vibe environment path is not a directory: $path" >&2
        exit 1
    fi
}

ensure_directory "$config_dir"
ensure_directory "$env_dir"
chmod 700 "$env_dir"

if [ -L "$env_file" ]; then
    printf '%s\n' "Vibe environment file is symlinked: $env_file" >&2
    exit 1
fi
if [ -e "$env_file" ]; then
    if [ ! -f "$env_file" ]; then
        printf '%s\n' "Vibe environment path is not a file: $env_file" >&2
        exit 1
    fi
    exit 0
fi

umask 077
temporary_file=
cleanup() {
    status=$?
    trap - EXIT HUP INT TERM
    if [ -n "$temporary_file" ]; then
        rm -f "$temporary_file" || status=$?
    fi
    exit "$status"
}
trap cleanup EXIT HUP INT TERM
temporary_file=$(mktemp "$env_dir/.goog.env.XXXXXX")

cat >"$temporary_file" <<'EOF'
# Fill in the Goog endpoint and key before sourcing this file.
export GOOG_BASE_URL='https://models.example/v1'
export GOOG_API_KEY=''
export GOOG_MODEL='qwen3.8'
EOF
chmod 600 "$temporary_file"

if ln "$temporary_file" "$env_file" 2>/dev/null; then
    printf '%s\n' "Created Vibe environment template: $env_file"
elif [ -L "$env_file" ]; then
    printf '%s\n' "Vibe environment file is symlinked: $env_file" >&2
    exit 1
elif [ -f "$env_file" ]; then
    :
elif [ -e "$env_file" ]; then
    printf '%s\n' "Vibe environment path is not a file: $env_file" >&2
    exit 1
else
    printf '%s\n' "Could not publish Vibe environment template: $env_file" >&2
    exit 1
fi
