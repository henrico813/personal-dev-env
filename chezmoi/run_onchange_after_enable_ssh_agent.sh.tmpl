#!/usr/bin/env bash
# Makes pde-ssh-agent.service the only SSH agent, so a key added once with
# ssh-add in a terminal works in every shell and no popup asks for it.
# The hash below makes chezmoi run this again when the unit changes.
# unit {{ include "dot_config/systemd/user/pde-ssh-agent.service" | sha256sum }}
set -euo pipefail

backup="$HOME/.local/state/pde/ssh-agent-backup"
others=(gcr-ssh-agent.socket gcr-ssh-agent.service gpg-agent-ssh.socket)

# Keep the first restore.sh, so it returns to the state before this script.
# It leaves pde-ssh-agent running, because shells and the session still use it.
if [[ ! -e "$backup/restore.sh" ]]; then
    mkdir -p "$backup"
    cat >"$backup/restore.sh" <<EOF
#!/usr/bin/env bash
systemctl --user unmask ${others[*]}
systemctl --user start gcr-ssh-agent.socket gpg-agent-ssh.socket
EOF
    echo "To turn the other SSH agents back on: bash $backup/restore.sh"
fi

# systemctl --user only works when a systemd user manager is running, which
# Docker smoke tests lack.
if ! command -v systemctl >/dev/null 2>&1 || ! systemctl --user show-environment >/dev/null 2>&1; then
    exit 0
fi
systemctl --user daemon-reload
systemctl --user mask "${others[@]}"
# Desktop and gnupg packages ship these units, so a server may lack some.
for unit in "${others[@]}"; do
    systemctl --user stop "$unit" || true
done
systemctl --user enable pde-ssh-agent.service

sock="$XDG_RUNTIME_DIR/pde-ssh-agent.socket"
# ssh-add -l exits 0 only when the agent answers and holds a key.
holds_keys() { [[ -S $1 ]] && SSH_AUTH_SOCK="$1" ssh-add -l >/dev/null 2>&1; }

# With no id_github.pub, want stays empty and no old agent is reused.
want=$(ssh-keygen -lf "$HOME/.ssh/id_github.pub" 2>/dev/null | awk '{print $2}' || true)
# The shared agent must hold only the GitHub key; id_homelab logs in as root.
holds_only_github() {
    local have
    have=$(SSH_AUTH_SOCK="$1" ssh-add -l 2>/dev/null | awk '{print $2}') || return 1
    [[ -n $want && $have == "$want" ]]
}
# A forwarded agent from ssh -A has no SSH_AGENT_PID, so it fails here.
is_own_ssh_agent() {
    local pid=$1 old=$2 dir=${2%/*}
    [[ $pid =~ ^[0-9]+$ && -O /proc/$pid && $(cat "/proc/$pid/comm" 2>/dev/null) == ssh-agent ]] || return 1
    [[ -S $old && ! -L $old && -O $old && ! -L $dir && -O $dir && $(stat -c %a "$dir") == 700 ]]
}

# Hand over a GitHub key added before the install, so the user need not run
# ssh-add again. The keyring's agent asks in a popup, so it is never reused.
# Any start of the unit replaces the link with a new, empty agent.
if ! holds_keys "$sock"; then
    keychain_env="$HOME/.keychain/$(uname -n)-sh"
    keychain_sock=$(sed -n 's/^SSH_AUTH_SOCK="\{0,1\}\([^";]*\).*/\1/p' "$keychain_env" 2>/dev/null || true)
    keychain_pid=$(sed -n 's/^SSH_AGENT_PID=\([0-9]*\).*/\1/p' "$keychain_env" 2>/dev/null || true)
    for pair in "${SSH_AGENT_PID:-}:${SSH_AUTH_SOCK:-}" "$keychain_pid:$keychain_sock"; do
        pid=${pair%%:*} old=${pair#*:}
        if is_own_ssh_agent "$pid" "$old" && holds_only_github "$old"; then
            systemctl --user stop pde-ssh-agent.service
            ln -sfn "$old" "$sock"
            break
        fi
    done
fi
if ! holds_keys "$sock"; then
    systemctl --user start pde-ssh-agent.service
fi
