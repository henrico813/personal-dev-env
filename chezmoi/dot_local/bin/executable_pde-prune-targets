#!/usr/bin/env bash
# Deletes Rust build folders (cargo's target) that no one uses, so scratch
# copies and finished worktrees do not fill the disk. A systemd user timer
# runs it every hour. With --dry-run it only lists what it would delete.
#
# A target folder is deleted when cargo made it, no file in it changed for
# two hours, and no running program has its working folder or executable
# inside it. It also has to sit in a copy under $TMPDIR (/tmp when unset), or
# in a worktree under ~/Projects/*/worktrees whose branch has at least one
# pull request and no open one.
set -uo pipefail
shopt -s nullglob

idle_minutes=120
dry_run=false
case ${1:-} in
'') ;;
--dry-run) dry_run=true ;;
*)
    echo "usage: pde-prune-targets [--dry-run]" >&2
    exit 2
    ;;
esac

# Prints the working folder and executable of every running program.
list_busy_paths() {
    find /proc/[0-9]*/cwd /proc/[0-9]*/exe -maxdepth 0 -printf '%l\n' 2>/dev/null
}

# Prints the target folders below a folder, at most the given depth down,
# without leaving its disk.
find_targets() {
    find "$1" -xdev -maxdepth "$2" \( -name node_modules -o -name .git \) -prune \
        -o -type d -name target -print -prune 2>/dev/null
}

# Succeeds when cargo made the folder, it sat idle, and no program uses it.
is_idle_cargo_target() {
    local target=$1 real path busy_paths
    grep -qs 'created by cargo' "$target/CACHEDIR.TAG" || return 1
    [[ -z $(find "$target" -mmin "-$idle_minutes" -print -quit 2>/dev/null) ]] || return 1
    # /proc shows resolved paths, so compare the folder's resolved path.
    real=$(realpath -e -- "$target") || return 1
    mapfile -t busy_paths < <(list_busy_paths)
    # The list always holds this script's own process, so an empty one means
    # /proc is unreadable.
    ((${#busy_paths[@]} > 0)) || return 1
    for path in "${busy_paths[@]}"; do
        if [[ $path == "$real" || $path == "$real"/* ]]; then
            return 1
        fi
    done
}

# Succeeds when the worktree's branch has pull requests and none is open.
# It fails when gh fails or takes over a minute, so the build stays.
are_branch_prs_finished() {
    local worktree=$1 branch states
    branch=$(git -C "$worktree" symbolic-ref --quiet --short HEAD) || return 1
    states=$(cd "$worktree" && timeout 60 gh pr list --state all --head "$branch" \
        --json state --jq '.[].state') || return 1
    [[ -n $states ]] && ! grep -qx OPEN <<<"$states"
}

remove_target() {
    local target=$1 size
    size=$(du -sh "$target" 2>/dev/null | cut -f1)
    if $dry_run; then
        printf 'would remove %s (%s)\n' "$target" "$size"
    elif rm -rf --one-file-system -- "$target"; then
        printf 'removed %s (%s)\n' "$target" "$size"
    fi
}

# Agents nest copies a few folders deep, such as /tmp/run.x/work/repo/target.
# The trailing slash makes find enter a TMPDIR that is a link.
while IFS= read -r target; do
    if is_idle_cargo_target "$target"; then
        remove_target "$target"
    fi
done < <(find_targets "${TMPDIR:-/tmp}/" 5)

for worktree in "$HOME"/Projects/*/worktrees/*/; do
    worktree=${worktree%/}
    idle_targets=()
    while IFS= read -r target; do
        if is_idle_cargo_target "$target"; then
            idle_targets+=("$target")
        fi
    done < <(find_targets "$worktree" 2)
    # Asking gh only for idle builds keeps the hourly run to a few calls.
    if ((${#idle_targets[@]} == 0)) || ! are_branch_prs_finished "$worktree"; then
        continue
    fi
    for target in "${idle_targets[@]}"; do
        remove_target "$target"
    done
done
