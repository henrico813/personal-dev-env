id = "pde.comment-review"
name = "PDE comment review"
version = "0.1.0"
min_herdr_version = "0.9.1"
platforms = ["linux"]

[[panes]]
id = "popup"
title = "Comment review"
placement = "popup"
width = 40
height = 16
command = ["{{ .chezmoi.destDir }}/.local/bin/pde-comment-review", "popup"]

[[panes]]
id = "edit"
title = "Edit comment"
placement = "tab"
command = ["{{ .chezmoi.destDir }}/.local/bin/pde-comment-review", "edit"]

[[panes]]
id = "diff"
title = "Comment review changes"
placement = "tab"
command = ["{{ .chezmoi.destDir }}/.local/bin/pde-comment-review", "diff"]

[[actions]]
id = "open"
title = "Open comment review"
contexts = ["workspace"]
command = ["{{ .chezmoi.destDir }}/.local/bin/pde-comment-review", "open"]
