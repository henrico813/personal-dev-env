# Disable terminal flow control to enable Ctrl-S for forward history search
stty -ixon

{{- if eq (env "PDE_PROFILE") "full" }}
# SSH agent via keychain (lazy key loading)
if command -v keychain &>/dev/null; then
    eval "$(keychain --eval --agents ssh --quiet)"
fi
{{- end }}

# Plugins are checksummed chezmoi externals and load only from local paths.
PDE_ZSH_PLUGINS=${ZDOTDIR:-$HOME}/.local/share/zsh/plugins
for plugin in colored-man-pages command-not-found git git-extras{{ if eq (env "PDE_PROFILE") "full" }} node{{ end }}; do
    source "$PDE_ZSH_PLUGINS/ohmyzsh/plugins/$plugin/$plugin.plugin.zsh"
done
fpath=("$PDE_ZSH_PLUGINS/zsh-completions/src" $fpath)
autoload -Uz compinit && compinit
source "$PDE_ZSH_PLUGINS/powerlevel10k/powerlevel10k.zsh-theme"
source "$PDE_ZSH_PLUGINS/zsh-z/zsh-z.plugin.zsh"
source "$PDE_ZSH_PLUGINS/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$PDE_ZSH_PLUGINS/zsh-history-substring-search/zsh-history-substring-search.zsh"
source "$PDE_ZSH_PLUGINS/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# Fix Ctrl-R and Ctrl-S for history search (must be after plugins load)
bindkey '^R' history-incremental-search-backward
bindkey '^S' history-incremental-search-forward

{{- if eq (env "PDE_PROFILE") "full" }}
# List out all globally installed npm packages
alias list-npm-globals='npm list -g --depth=0'
# use neovim instead of vim
alias vim='nvim'
{{- end }}
# checkout branch using fzf
alias gcob='git branch | fzf | xargs git checkout'
{{- if eq (env "PDE_PROFILE") "full" }}
# open vim config from anywhere
alias vimrc='vim ${HOME}/.config/nvim/init.lua'
_opencode_run_with_credentials() (
    local env_file="$HOME/.config/opencode/server.env"
    local line name value

    case "$1" in
        attach|web) ;;
        *) return 2 ;;
    esac

    if [[ ! -f "$env_file" || -L "$env_file" ]]; then
        print -u2 "OpenCode credentials are unavailable: $env_file"
        return 1
    fi

    unset OPENCODE_SERVER_USERNAME OPENCODE_SERVER_PASSWORD
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            ""|\#*) ;;
            OPENCODE_SERVER_USERNAME=*|OPENCODE_SERVER_PASSWORD=*)
                name="${line%%=*}"
                value="${line#*=}"
                [[ -z "${(P)name}" && -n "$value" ]] || return 1
                typeset -gx "$name=$value"
                ;;
            *) return 1 ;;
        esac
    done < "$env_file"

    [[ -n "$OPENCODE_SERVER_USERNAME" && -n "$OPENCODE_SERVER_PASSWORD" ]] || return 1
    command opencode "$@"
)

oca() (
    local dir url attempt

    unset OPENCODE_SERVER_USERNAME OPENCODE_SERVER_PASSWORD
    dir="$(command git rev-parse --show-toplevel 2>/dev/null)" || dir="$PWD"
    url="${OPENCODE_ATTACH_URL:-http://127.0.0.1:4096}"
    if [[ "$url" == "http://127.0.0.1:4096" ]] && ! command curl --fail --silent --show-error --max-time 2 "$url" >/dev/null 2>&1; then
        command systemctl --user restart opencode-web.service || return 1
        for attempt in {1..10}; do
            command curl --fail --silent --show-error --max-time 2 "$url" >/dev/null 2>&1 && break
            if [[ "$attempt" == 10 ]]; then
                print -u2 -- "OpenCode server did not become ready: $url"
                return 1
            fi
            command sleep 1
        done
    fi
    if [[ -e "$HOME/.config/opencode/server.env" || -L "$HOME/.config/opencode/server.env" ]]; then
        _opencode_run_with_credentials attach "$url" --dir "$dir" "$@"
    else
        command opencode attach "$url" --dir "$dir" "$@"
    fi
)

ocw() (
    _opencode_run_with_credentials web "$@"
)

ocw-password() (
    local env_dir="$HOME/.config/opencode"
    local env_file="$env_dir/server.env"
    local password confirmation tmp

    if [[ -L "$HOME/.config" || -L "$env_dir" || -L "$env_file" ||
        -d "$env_file" || ( -e "$env_file" && ! -f "$env_file" ) ]]; then
        print -u2 "OpenCode credentials path is not a regular file"
        return 1
    fi

    print -n "OpenCode password: "
    read -r -s password || { print; return 1; }
    print
    print -n "Confirm OpenCode password: "
    read -r -s confirmation || { print; return 1; }
    print

    if [[ -z "$password" || -z "$confirmation" ]]; then
        print -u2 "OpenCode passwords must not be empty"
        return 1
    fi
    if [[ "$password" != "$confirmation" ]]; then
        print -u2 "OpenCode passwords must match"
        return 1
    fi
    if [[ "$password" == *[!A-Za-z0-9._:@%+,-]* ]]; then
        print -u2 "Use letters, numbers, or . _ : @ % + , - in the password"
        return 1
    fi

    command install -d -m 700 "$env_dir" || return 1
    command chmod 700 "$env_dir" || return 1
    umask 077
    tmp="$(command mktemp "$env_file.XXXXXX")" || return 1
    trap 'command rm -f -- "$tmp"' EXIT
    if ! printf 'OPENCODE_SERVER_USERNAME=opencode\nOPENCODE_SERVER_PASSWORD=%s\n' \
        "$password" >"$tmp" || ! command chmod 600 "$tmp" ||
        ! command mv -f -- "$tmp" "$env_file"; then
        return 1
    fi
    trap - EXIT

    command systemctl --user daemon-reload || return 1
    command systemctl --user enable --now opencode-web.service opencode-web-health.timer || return 1
    print "OpenCode credentials saved to $env_file"
)
{{- end }}
# cat -> bat
alias cat='bat'
# colored ls output
alias ls='eza -al'

# DIRCOLORS (MacOS)
export CLICOLOR=1

# FZF
export FZF_DEFAULT_COMMAND="rg --files --hidden --glob '!.git'"
export FZF_DEFAULT_OPTS="--height=40% --layout=reverse --border --margin=1 --padding=1"

# PATH
export PATH="$HOME/.local/bin:$PATH"
export AQUA_ROOT_DIR="$HOME/.local/share/aquaproj-aqua"
{{- if eq (env "PDE_PROFILE") "terminal" }}
export AQUA_GLOBAL_CONFIG="$HOME/.config/aquaproj-aqua/aqua-terminal.yaml"
export AQUA_CHECKSUMS_PATH="$HOME/.config/aquaproj-aqua/aqua-terminal-checksums.json"
{{- else }}
