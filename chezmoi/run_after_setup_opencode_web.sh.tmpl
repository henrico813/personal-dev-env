#!/bin/sh
set -eu

{{- if eq (env "PDE_PROFILE") "full" }}
service=opencode-web.service
timer=opencode-web-health.timer
env_file="$HOME/.config/opencode/server.env"

systemctl --user daemon-reload
if [ -f "$env_file" ] && [ ! -L "$env_file" ]; then
    systemctl --user enable --now "$service" "$timer"
else
    systemctl --user disable --now "$service" "$timer" >/dev/null 2>&1 || true
    printf '%s\n' "OpenCode credentials are unavailable; run ocw-password to create $env_file." >&2
fi
{{- end }}
