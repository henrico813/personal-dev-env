# i3 config file
# Modifier key (Mod4 = Super/Windows key)
set $mod Mod4

# Font
font pango:JetBrainsMono Nerd Font 10

# Border style
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# Colors (dracula-inspired)
# class                 border  backgr. text    indicator child_border
client.focused          #bd93f9 #bd93f9 #f8f8f2 #ff79c6   #bd93f9
client.focused_inactive #44475a #44475a #f8f8f2 #44475a   #44475a
client.unfocused        #282a36 #282a36 #bfbfbf #282a36   #282a36
client.urgent           #ff5555 #ff5555 #f8f8f2 #ff5555   #ff5555

# ---------- WORKSPACE SWITCHING ----------
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# ---------- MONITOR FOCUS ----------
bindsym $mod+comma focus output left
bindsym $mod+period focus output right

# Move workspace to different monitor
bindsym $mod+Shift+comma move workspace to output left
bindsym $mod+Shift+period move workspace to output right

# Move container to different monitor (keeps workspace)
bindsym $mod+Ctrl+comma move container to output left
bindsym $mod+Ctrl+period move container to output right

# ---------- APPLICATIONS ----------
bindsym $mod+q exec --no-startup-id rofi -show drun -show-icons
bindsym $mod+Tab exec --no-startup-id rofi -show window -show-icons
bindsym $mod+e exec thunar
bindsym $mod+Shift+s exec xfce4-screenshooter
bindsym $mod+x exec --no-startup-id ~/.config/pde-desktop/scripts/powermenu.sh
bindsym $mod+n exec --no-startup-id ~/.config/pde-desktop/scripts/wifi-menu.sh

# ---------- WINDOW MANAGEMENT ----------
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

# Focus (vim-style)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Focus (arrow keys)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move (vim-style)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Move (arrow keys)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split
bindsym $mod+b split h
bindsym $mod+v split v

# Layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+y layout toggle split

# Fullscreen
bindsym $mod+f fullscreen toggle

# Floating
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt

    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ---------- MEDIA KEYS ----------
# Volume (with notifications)
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/pde-desktop/scripts/volume-notify.sh up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/pde-desktop/scripts/volume-notify.sh down
bindsym XF86AudioMute exec --no-startup-id ~/.config/pde-desktop/scripts/volume-notify.sh mute
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Brightness (with notifications)
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/pde-desktop/scripts/brightness-notify.sh 5%+
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/pde-desktop/scripts/brightness-notify.sh 5%-

# Media player controls
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# Power button opens power menu
bindsym XF86PowerOff exec --no-startup-id ~/.config/pde-desktop/scripts/powermenu.sh

# Screenshot
bindsym Print exec --no-startup-id xfce4-screenshooter
bindsym Shift+Print exec --no-startup-id xfce4-screenshooter -r

# ---------- THIS MACHINE ----------
# Outputs, workspaces, the monitor layout and the terminal key. It comes before
# autostart, so autorandr sets the layout before the wallpaper and polybar read it.
include ~/.config/i3/local.conf

# ---------- AUTOSTART ----------
# XDG autostart entries, which the stock i3 login entry does not run. These
# include picom and xfce4-power-manager, so they have no exec line here.
exec --no-startup-id dex --autostart --environment i3

# Wallpaper (the video in ~/.config/wallpapers, or Ubuntu's default image)
exec_always --no-startup-id ~/.config/pde-desktop/scripts/wallpaper.sh

# Notifications
exec --no-startup-id dunst

# Authentication agent (for GUI sudo prompts)
exec --no-startup-id lxpolkit

# Screen lock on idle
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -c 282a36

# ---------- WINDOW RULES ----------
# Float specific windows
for_window [class="Thunar" title="File Operation Progress"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [class="Xfce4-power-manager-settings"] floating enable
for_window [class="Arandr"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable

# ---------- STATUS BAR ----------
# Using Polybar instead of i3bar
exec_always --no-startup-id ~/.config/polybar/launch.sh
