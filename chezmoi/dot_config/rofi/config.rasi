configuration {
    modi: "drun,run,window";
    show-icons: true;
    drun-display-format: "{name}";
    location: 0;
    disable-history: false;
    sidebar-mode: true;

    /* Vim keys. Plain letters filter the list, so these use Ctrl. */
    kb-row-down: "Down,Control+n,Control+j";
    kb-row-up: "Up,Control+p,Control+k";
    kb-mode-previous: "Shift+Left,Control+ISO_Left_Tab,Control+h";
    kb-mode-next: "Shift+Right,Control+Tab,Control+l";
    kb-accept-entry: "Control+m,Return,KP_Enter";
    kb-remove-to-eol: "";
    kb-remove-char-back: "BackSpace,Shift+BackSpace";
    kb-mode-complete: "";
}

/* pde everforest-dark */
* {
    bg: #2d353b;
    bg-alt: #343f44;
    fg: #d3c6aa;
    accent: #7fbbb3;
    urgent: #e67e80;
    background-color: @bg;
    text-color: @fg;
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 8px;
    padding: 20px;
    width: 640px;
}

/* Only Super+q shows a help line; desktop-menu.sh fills textbox-help. */
mainbox {
    children: [inputbar, listview, mode-switcher, message];
    spacing: 8px;
}

message {
    border: 0;
    background-color: @bg-alt;
    border-radius: 4px;
    padding: 6px 8px;
}

textbox {
    background-color: inherit;
    text-color: @fg;
    markup: true;
    horizontal-align: 0.5;
}

textbox-help {
    expand: false;
    background-color: @bg-alt;
    text-color: @fg;
    border-radius: 4px;
    padding: 6px 8px;
    markup: true;
    horizontal-align: 0.5;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg;
    border-radius: 4px;
    padding: 8px;
}

prompt {
    background-color: @accent;
    padding: 8px 12px;
    text-color: @bg;
    border-radius: 4px;
    margin: 0 8px 0 0;
}

entry {
    padding: 8px;
    text-color: @fg;
    background-color: @bg;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    border: 0;
    scrollbar: false;
}

element {
    padding: 8px;
    border-radius: 4px;
}

element normal.normal {
    background-color: @bg;
    text-color: @fg;
}

element alternate.normal {
    background-color: @bg;
    text-color: @fg;
}

element selected,
element selected.normal {
    background-color: @accent;
    text-color: @bg;
}

element normal.urgent,
element alternate.urgent {
    background-color: @bg;
    text-color: @urgent;
}

element normal.active,
element alternate.active {
    background-color: @bg;
    text-color: @accent;
}

button {
    background-color: @bg-alt;
    text-color: @fg;
    padding: 6px;
    border-radius: 4px;
}

button selected {
    background-color: @accent;
    text-color: @bg;
}

element-text {
    text-color: inherit;
}

element-icon {
    size: 24px;
    padding: 0 8px 0 0;
}
