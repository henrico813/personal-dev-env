[Unit]
Description=Run every skill's eval cases on Sonnet

[Service]
Type=oneshot
# The checkout the last install came from, so the cases match the
# installed skills. trials.py finds the skills from this folder.
WorkingDirectory={{ env "PDE_REPO_ROOT" }}
# Keep --model the first Review model in model-routing's Models list.
# It runs at its default reasoning, as the cases were tried, while the
# scorer runs at medium. trials.md says when the local model may take over.
ExecStart=/usr/bin/python3 {{ env "PDE_REPO_ROOT" }}/ai/skills/session-review/scripts/trials.py --all-skills --without --model claude-code/claude-sonnet-5
# trials.py runs opencode, from ~/.local/bin, and git.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Print each case line to the journal as it ends, not at exit.
Environment=PYTHONUNBUFFERED=1
# Each run stops after 10 minutes, but every case of every skill, three
# times each, can take hours.
TimeoutStartSec=6h
Nice=10
