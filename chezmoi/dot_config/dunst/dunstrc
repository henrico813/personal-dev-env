[global]
    monitor = 0
    follow = mouse
    width = (300, 600)
    offset = (10, 10)
    origin = top-center
    layer = overlay

    notification_limit = 5
    indicate_hidden = yes

    padding = 12
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#7fbbb3"
    separator_color = frame

    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"

    icon_position = left
    max_icon_size = 48

    corner_radius = 8

    # The context menu (Super+o) uses rofi, so it gets the rofi vim keys.
    dmenu = /usr/bin/rofi -dmenu -p dunst

[urgency_low]
    background = "#2d353b"
    foreground = "#d3c6aa"
    timeout = 5

[urgency_normal]
    background = "#2d353b"
    foreground = "#d3c6aa"
    timeout = 10

[urgency_critical]
    background = "#e67e80"
    foreground = "#2d353b"
    frame_color = "#e67e80"
    timeout = 0
