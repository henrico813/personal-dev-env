[global]
    monitor = 0
    follow = mouse
    width = (300, 600)
    offset = (10, 10)
    origin = top-center
    layer = overlay

    notification_limit = 5
    indicate_hidden = yes

    padding = 12
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#bd93f9"
    separator_color = frame

    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"

    icon_position = left
    max_icon_size = 48

    corner_radius = 8

[urgency_low]
    background = "#282a36"
    foreground = "#f8f8f2"
    timeout = 5

[urgency_normal]
    background = "#282a36"
    foreground = "#f8f8f2"
    timeout = 10

[urgency_critical]
    background = "#ff5555"
    foreground = "#f8f8f2"
    frame_color = "#ff5555"
    timeout = 0
