{{- $profile := env "PDE_PROFILE" -}}
{{- if not (or (eq $profile "full") (eq $profile "client") (eq $profile "terminal")) -}}
{{ fail "PDE_PROFILE must be exactly terminal, client, or full" }}
{{- end }}
{{- $colorProfile := env "PDE_COLOR_PROFILE" -}}
{{- if not (index .colorProfiles $colorProfile) -}}
{{ fail "PDE_COLOR_PROFILE must select a defined color profile" }}
{{- end }}

README.md
.config/nvim/pack/plugins/start/opencode-inline.nvim
.config/nvim/pack/plugins/start/opencode-inline.nvim/**
{{- if ne $profile "full" }}
.config/aquaproj-aqua/aqua.yaml
.config/aquaproj-aqua/aqua-checksums.json
.claude
.claude/**
.codex
.codex/**
.pi
.pi/**
# The Herdr approval and comment review popups are full-profile only, like
# pde-gh-write.
.local/share/pde/herdr-plugins
.local/share/pde/herdr-plugins/**
# Scripts are ignored by name without their run_after_ prefix.
link_herdr_plugins.sh
# The planner link points at a build that only full installs.
.config/opencode/bin/planner
{{- if eq $profile "terminal" }}
# Terminal VMs have no editor or agents, so they skip these files.
.config/alacritty
.config/alacritty/**
.config/wezterm
.config/wezterm/**
.config/nvim
.config/nvim/**
.config/opencode
.config/opencode/**
.local/bin/opencode
.config/herdr
.config/herdr/**
.agents
.agents/**
{{- end }}
{{- else }}
.config/aquaproj-aqua/aqua-terminal.yaml
.config/aquaproj-aqua/aqua-terminal-checksums.json
# The installer builds blink.cmp with its Rust matcher on full.
.config/nvim/pack/plugins/start/blink.cmp
.config/nvim/pack/plugins/start/blink.cmp/**
{{- end }}
