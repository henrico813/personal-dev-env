.config/alacritty/**
.config/wezterm
.config/wezterm/**
.config/nvim
.config/nvim/**
.config/opencode
.config/opencode/**
.codex
.codex/**
.agents
.agents/**
.pi
.pi/**
.config/systemd/user/opencode-web.service
{{- else }}
.config/aquaproj-aqua/aqua-terminal.yaml
