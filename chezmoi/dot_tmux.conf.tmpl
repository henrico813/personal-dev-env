{{- $colors := index .colorProfiles (env "PDE_COLOR_PROFILE") -}}
# Terminal colors - required for prompt and editor colors to match outside tmux
# macOS has no tmux-256color terminfo entry, so it uses screen-256color.
set -g default-terminal "{{ if eq .chezmoi.os "darwin" }}screen-256color{{ else }}tmux-256color{{ end }}"
set -ga terminal-overrides ",*256col*:Tc"

# Change prefix from 'Ctrl+B' to 'Ctrl+A'
unbind C-b
set-option -g prefix C-a
bind-key C-a send-prefix

# Accidentally pressing space closes windows and I don't like that.
unbind Space

set-option -g status-position top
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows off
set -g status-justify left

# Status bar styling - {{ $colors.label }} rounded powerline hybrid
set -g status-style bg={{ $colors.terminal.background }}
set -g status-left-length 30
set -g status-right-length 50
set -g status-left "#[fg={{ $colors.ui.accent }}]#[bg={{ $colors.ui.accent }},fg={{ $colors.terminal.background }},bold] #S #[bg={{ $colors.terminal.background }},fg={{ $colors.ui.accent }}] "
set -g window-status-separator ""
set -g window-status-format         "#[fg={{ $colors.ui.subtle }}] #I:#W "
set -g window-status-current-format "#[fg={{ $colors.ui.muted }}]#[bg={{ $colors.ui.muted }},fg={{ $colors.terminal.foreground }},bold] #I:#W #[bg={{ $colors.terminal.background }},fg={{ $colors.ui.muted }}]"
set -g status-right "#[fg={{ $colors.ui.secondary }}]#[bg={{ $colors.ui.secondary }},fg={{ $colors.terminal.background }}] %d %b #[bg={{ $colors.terminal.background }},fg={{ $colors.ui.secondary }}]#[fg={{ $colors.ui.accent }}]#[bg={{ $colors.ui.accent }},fg={{ $colors.terminal.background }}] %H:%M #[bg={{ $colors.terminal.background }},fg={{ $colors.ui.accent }}]"

# Open new panes in the current window's directory.
bind '"' split-window -v -c "#{pane_current_path}"
bind %   split-window -h -c "#{pane_current_path}"
bind c   new-window      -c "#{pane_current_path}"

# Pane navigation (vim keys)
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# Pane borders
set -g pane-border-lines heavy
set -g pane-border-style fg={{ $colors.ui.muted }}
set -g pane-active-border-style fg={{ $colors.ui.accent }}

# Preserve last-window — moved off prefix-l
bind Tab last-window

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'

# Pane number display colors
set -g display-panes-colour "{{ $colors.ui.muted }}"
set -g display-panes-active-colour "{{ $colors.ui.accent }}"
set -g display-panes-time 2000

# Make copy pasting easier by enabling vim keybindings for scroll mode.
set-window-option -g mode-keys vi
bind-key -T copy-mode-vi v send -X begin-selection
bind-key -T copy-mode-vi V send -X select-line
# These commands copy to the system clipboard in scroll mode, with pbcopy on
# macOS and xclip on Linux.
{{- $copy := "xclip -in -selection clipboard" }}{{ if eq .chezmoi.os "darwin" }}{{ $copy = "pbcopy" }}{{ end }}
set -s set-clipboard on
set -s copy-command '{{ $copy }}'
bind-key -T copy-mode-vi y send -X copy-pipe-and-cancel '{{ $copy }}'
# Enable mouse activation of scroll mode.
set -g mouse on

# Image passthrough for Yazi image preview.
set -g allow-passthrough on
set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM

{{- if has "workstation" .pde.tiers }}
# Restore vim and neovim sessions, plus pane contents, across tmux restarts.
set -g @resurrect-strategy-vim 'session'
set -g @resurrect-strategy-nvim 'session'
set -g @resurrect-processes 'ssh vim nvim'
{{- else }}
# Restore SSH sessions across tmux restarts.
set -g @resurrect-processes 'ssh'
{{- end }}
set -g @resurrect-capture-pane-contents 'on'

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.tmux/plugins/tpm/tpm'
