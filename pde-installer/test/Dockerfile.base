ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive

# Setting these in apt's config also covers the installer's apt-get calls.
# CI sets UBUNTU_MIRROR to the Azure mirror its runners sit next to.
ARG UBUNTU_MIRROR=
RUN printf 'Acquire::Retries "5";\n' >/etc/apt/apt.conf.d/80-retries \
	&& if [ -n "$UBUNTU_MIRROR" ]; then \
		for list in /etc/apt/sources.list /etc/apt/sources.list.d/ubuntu.sources; do \
			if [ -f "$list" ]; then sed -i \
				-e "s|http://archive.ubuntu.com/ubuntu|$UBUNTU_MIRROR|" \
				-e "s|http://security.ubuntu.com/ubuntu|$UBUNTU_MIRROR|" "$list"; fi; \
		done; \
	fi

# A mirror mid-sync can list packages it does not have yet, which apt
# reports as 404 and does not retry. A later apt-get update clears it.
RUN for attempt in 1 2 3; do \
		apt-get update && apt-get install -y \
			bison build-essential bzip2 ca-certificates curl file fontconfig gawk git gzip libevent-dev \
			libncurses-dev make patch pkg-config python3 sudo tar unzip xclip xz-utils zsh \
			&& break; \
		if [ "$attempt" = 3 ]; then exit 1; fi; \
		sleep 60; \
	done \
	&& rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash testuser
RUN printf 'testuser ALL=(ALL) NOPASSWD: ALL\n' >/etc/sudoers.d/testuser

USER testuser
WORKDIR /home/testuser
