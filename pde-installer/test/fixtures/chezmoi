#!/bin/sh
set -eu

target="$HOME/.zshrc"
profile="${PDE_PROFILE:-}"
case "$profile" in
full|terminal) ;;
*) printf 'fixture chezmoi: invalid profile\n' >&2; exit 1 ;;
esac
rendered="# fixture profile: $profile\n"
rendered_file="$(mktemp)"
trap 'rm -f "$rendered_file"' EXIT
printf '%b' "$rendered" >"$rendered_file"
fail_marker="$PDE_REPO_ROOT/chezmoi/.pde-smoke-fail"
gitconfig_source="$PDE_REPO_ROOT/chezmoi/dot_config/pde/gitconfig"
hook_source="$PDE_REPO_ROOT/chezmoi/dot_config/git/template/hooks/executable_commit-msg"
configure_git_template="$PDE_REPO_ROOT/chezmoi/run_onchange_after_configure_git_template.sh.tmpl"
action=""
for argument in "$@"; do
	case "$argument" in
	status|diff|apply) action="$argument" ;;
	esac
done

case "$action" in
status)
	if ! printf '%b' "$rendered" | cmp -s - "$target"; then
		printf ' M %s\n' "$target"
	fi
	if [ -e "$HOME/.config/pde/paths.env" ]; then
		printf ' D %s\n' "$HOME/.config/pde/paths.env"
	fi
	if [ -e "$fail_marker" ]; then
		printf ' M %s\n' "$HOME/.config/opencode/transaction-marker"
		printf ' A %s\n' "$HOME/.config/pde/smoke-created/content"
	fi
	;;
diff)
	diff -u "$target" "$rendered_file" 2>/dev/null || true
	;;
apply)
	cp "$rendered_file" "$target"
	rm -f "$HOME/.config/pde/paths.env"
	mkdir -p "$HOME/.config/pde" "$HOME/.config/git/template/hooks"
	cp "$gitconfig_source" "$HOME/.config/pde/gitconfig"
	install -m 0755 "$hook_source" "$HOME/.config/git/template/hooks/commit-msg"
	bash "$configure_git_template"
	if [ -e "$fail_marker" ]; then
		printf 'changed\n' >"$HOME/.config/opencode/transaction-marker"
		mkdir -p "$HOME/.config/pde/smoke-created"
		printf 'new\n' >"$HOME/.config/pde/smoke-created/content"
		exit 23
	fi
	;;
*)
	printf 'fixture chezmoi: unsupported command\n' >&2
	exit 2
	;;
esac
