#!/usr/bin/env python3
"""Lint and format commit or pull-request messages."""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
import textwrap
from pathlib import Path

MAX_TITLE = 50
MAX_BODY = 72
TYPES = "feat|fix|docs|test|refactor|perf|build|ci|chore|style|revert"
TITLE_RE = re.compile(rf"^(?:{TYPES})(?:\([^)]+\))?!?: .+")
# Finds the type, skipping a key that msg.titlePrefix allows before it.
TYPE_RE = re.compile(rf"(?:^|.*? )({TYPES})(?:\([^)]+\))?!?: ")
AGENT_FILE_NAMES = {
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "SKILL.md",
    "SOUL.md",
}
AGENT_FOLDERS = {"agents", "prompts", "skills"}
SUFFIX_RE = re.compile(r" \(#\d+\)$")
# A code span opens and closes with the same run of backticks.
CODE_SPAN_RE = re.compile(r"(?<!`)(`+)(?!`).+?(?<!`)\1(?!`)")
# Stands in for each space inside a code span while textwrap runs.
KEPT_SPACE = "\x00"
SECTIONS = ("## Overview", "## Changes", "## Testing")
PREFIXED_FORMAT_ERROR = (
    "line 1: title must match [<msg.titlePrefix>]<type>[(scope)][!]: <summary>"
)


def read_message(path: Path) -> list[str]:
    """Read a message while preserving its line structure."""
    return path.read_text(encoding="utf-8").splitlines()


def title_without_suffix(title: str) -> str:
    """Remove a trailing GitHub issue suffix from a title."""
    return SUFFIX_RE.sub("", title)


def git_output(*args: str) -> str | None:
    """Return git's output minus its final newline, or None if git fails.

    Only the newline is removed, so a quoted trailing space in a value stays.

    Args:
        args: Arguments after ``git``, run in the current directory.

    Returns:
        The output, or None when git is missing or exits nonzero.
    """
    try:
        result = subprocess.run(["git", *args], capture_output=True, text=True)
    except OSError:
        return None
    if result.returncode != 0:
        return None
    return result.stdout.removesuffix("\n")


def read_changed_paths(hook: bool, base: str | None = None) -> list[str]:
    """Return the files the message describes, or [] outside a checkout.

    A commit records its staged files. With nothing staged, as when
    checking PR or squash text, use the branch's files since it left
    ``base``, or the default branch that a remote's HEAD names. The
    remote need not be called origin. The hook runs before a commit, so
    it reads only staged files.

    Args:
        hook: Read only staged files.
        base: Branch a stacked PR targets, such as ``feat/parent``. Without
            it, a stacked PR would also count its parent's files.

    Returns:
        Repository-relative paths, such as ``ai/skills/x/SKILL.md``.
    """
    staged = git_output("diff", "--cached", "--name-only")
    if staged or hook:
        return staged.splitlines() if staged else []
    if base:
        remotes = (git_output("remote") or "").split()
        bases = [f"{remote}/{base}" for remote in remotes] + [base]
    else:
        heads = git_output(
            "for-each-ref", "--format=%(refname)", "refs/remotes/*/HEAD"
        )
        bases = (heads or "").split() + ["origin/main", "origin/master"]
    for ref in bases:
        branch = git_output("diff", "--name-only", f"{ref}...HEAD")
        if branch is not None:
            return branch.splitlines()
    return []


def is_agent_instruction(path: str) -> bool:
    """Return whether a file tells an agent what to do.

    Args:
        path: Repository-relative path with ``/`` separators.

    Returns:
        True for files such as AGENTS.md and SKILL.md, and for any file
        under an ``agents``, ``prompts`` or ``skills`` folder.
    """
    parts = path.split("/")
    in_agent_folder = not AGENT_FOLDERS.isdisjoint(parts[:-1])
    return parts[-1] in AGENT_FILE_NAMES or in_agent_folder


def find_docs_type_error(title: str, changed_paths: list[str]) -> str | None:
    """Return an error when a docs title covers agent instruction changes.

    Skill, prompt and AGENTS.md text controls what an agent does, so
    changing it is a feat or fix even when only Markdown changed.

    Args:
        title: Title without the ``(#N)`` suffix.
        changed_paths: Files the message describes.

    Returns:
        The error line, or None when the title is not docs or no agent
        instruction file changed.
    """
    match = TYPE_RE.match(title)
    if not match or match.group(1) != "docs":
        return None
    agent_paths = [path for path in changed_paths if is_agent_instruction(path)]
    if not agent_paths:
        return None
    more = f" and {len(agent_paths) - 1} more" if len(agent_paths) > 1 else ""
    return (
        f"line 1: docs type, but agent instructions changed "
        f"({agent_paths[0]}{more}); use feat or fix"
    )


def hide_code_span_spaces(text: str) -> str:
    """Replace each space inside a code span with ``KEPT_SPACE``.

    textwrap then sees a span such as `hub board` as one word, so it
    never breaks a line inside it.

    Args:
        text: One paragraph or list item, joined onto one line.

    Returns:
        The text with only the spaces inside code spans replaced.
    """
    return CODE_SPAN_RE.sub(
        lambda span: span[0].replace(" ", KEPT_SPACE), text
    )


def has_open_code_span(line: str) -> bool:
    """Return whether a line has a backtick outside any closed code span.

    Args:
        line: One message line outside a code fence.

    Returns:
        True when a backtick on the line is not part of a closed code
        span, as in "such as `hub".
    """
    return "`" in CODE_SPAN_RE.sub("", line)


def is_unbreakable(line: str) -> bool:
    """Return whether fmt cannot break a line any further.

    Args:
        line: One message line outside a code fence.

    Returns:
        True when the line, after any indent and list marker, is one word,
        such as a long URL or a long code span with its punctuation.
    """
    text = re.sub(r"^\s*(?:[-*+] |\d+\. )", "", line).strip()
    return bool(text) and " " not in hide_code_span_spaces(text)


def lint(
    lines: list[str],
    pull_request: bool,
    hook: bool = False,
    prefixed_title: re.Pattern[str] | None = None,
    changed_paths: list[str] | None = None,
) -> list[str]:
    """Return all rule violations in a message.

    Args:
        lines: Message lines, title first.
        pull_request: Also require the PR description sections.
        hook: Check as the commit-msg hook does: skip comments, and check
            only lengths unless ``prefixed_title`` is set.
        prefixed_title: Pattern built from msg.titlePrefix. It replaces
            ``TITLE_RE``, and hook mode checks it too, except for
            generated subjects such as ``fixup!``.
        changed_paths: Files the message describes. A docs title fails
            when one of them is an agent instruction file.

    Returns:
        One line per violation; empty when the message passes.
    """
    errors: list[str] = []
    if hook:
        for index, line in enumerate(lines):
            if line.startswith("# ------------------------ >8"):
                lines = lines[:index]
                break
        lines = [line for line in lines if not line.startswith("#")]
    if not lines or not lines[0]:
        return ["line 1: missing title"]
    title = lines[0]
    title_body = title_without_suffix(title)
    generated_subject = title.startswith(("fixup! ", "squash! ", "amend! ", "Merge ", 'Revert "'))
    docs_error = None
    if not generated_subject:
        docs_error = find_docs_type_error(title_body, changed_paths or [])
    if hook:
        if not generated_subject and len(title_body) > MAX_TITLE:
            errors.append(
                f"line 1: {len(title_body)} chars, max 50 (over by {len(title_body) - 50})"
            )
        if prefixed_title and not generated_subject and not prefixed_title.fullmatch(title_body):
            errors.append(PREFIXED_FORMAT_ERROR)
        if docs_error:
            errors.append(docs_error)
        fenced = False
        for number, line in enumerate(lines[1:], 2):
            if line.startswith("```"):
                fenced = not fenced
                continue
            if line.startswith("#") or fenced or is_unbreakable(line):
                continue
            if len(line) > MAX_BODY:
                errors.append(
                    f"line {number}: {len(line)} chars, max 72 (over by {len(line) - 72})"
                )
        return errors
    if not hook or not generated_subject:
        count = len(title_body)
        if count > MAX_TITLE:
            errors.append(f"line 1: {count} chars, max 50 (over by {count - 50})")
        if prefixed_title:
            if not prefixed_title.fullmatch(title_body):
                errors.append(PREFIXED_FORMAT_ERROR)
        elif not TITLE_RE.fullmatch(title_body):
            errors.append("line 1: title must match <type>[(scope)][!]: <summary>")
        if title_body.endswith("."):
            errors.append("line 1: title must not end with a period")
        if docs_error:
            errors.append(docs_error)
    if len(lines) > 1 and lines[1] != "":
        errors.append("line 2: must be blank")
    fenced = False
    for number, line in enumerate(lines[2:], 3):
        if line.startswith("```"):
            fenced = not fenced
            continue
        if fenced:
            continue
        if has_open_code_span(line):
            errors.append(f"line {number}: code span not closed on this line")
        if is_unbreakable(line):
            continue
        count = len(line)
        if count > MAX_BODY:
            errors.append(
                f"line {number}: {count} chars, max 72 (over by {count - 72})"
            )
    if pull_request:
        found = [line for line in lines if line in SECTIONS]
        if found != list(SECTIONS):
            errors.append("PR description must contain sections in order: " + ", ".join(SECTIONS))
    return errors


def wrap_lines(lines: list[str]) -> list[str]:
    """Wrap prose and list items without changing headings or code.

    A code span always stays on one line, even when it is longer than
    the limit.
    """
    output: list[str] = []
    fenced = False
    paragraph: list[str] = []

    def flush() -> None:
        if not paragraph:
            return
        if len(paragraph) == 1 and re.fullmatch(r"\s*(?:[-*+] |\d+\. )", paragraph[0]):
            output.append(paragraph[0])
            paragraph.clear()
            return
        joined = " ".join(item.strip() for item in paragraph)
        prefix = ""
        match = re.match(r"^(\s*(?:[-*+] |\d+\. ))", joined)
        if match:
            prefix = match.group(1)
            joined = joined[len(prefix):]
        if not joined:
            output.append(prefix)
        else:
            width = MAX_BODY - len(prefix)
            wrapped = textwrap.wrap(
                hide_code_span_spaces(joined), width=width,
                break_long_words=False, break_on_hyphens=False,
            )
            wrapped = [item.replace(KEPT_SPACE, " ") for item in wrapped]
            output.extend(
                [prefix + wrapped[0]]
                + [" " * len(prefix) + item for item in wrapped[1:]]
            )
        paragraph.clear()

    for line in lines:
        is_item = bool(re.match(r"^\s*(?:[-*+] |\d+\. )", line))
        if line.startswith("```"):
            flush()
            fenced = not fenced
            output.append(line)
        elif fenced or line.startswith("#") or not line.strip():
            flush()
            output.append(line)
        elif is_item:
            flush()
            paragraph.append(line)
        elif paragraph and re.match(r"^\s*(?:[-*+] |\d+\. )", paragraph[0]) and not line.startswith(" "):
            flush()
            paragraph.append(line)
        elif line.startswith("    ") and not (
            paragraph and re.match(r"^\s*(?:[-*+] |\d+\. )", paragraph[0])
        ):
            flush()
            output.append(line)
        else:
            paragraph.append(line)
    flush()
    return output


def format_message(path: Path) -> None:
    """Rewrite prose paragraphs and list items at the body limit."""
    lines = read_message(path)
    if len(lines) > 2:
        lines[2:] = wrap_lines(lines[2:])
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def squash_message(lines: list[str]) -> str:
    """Build a squash message from the title and Overview section."""
    if not lines or not lines[0].strip():
        raise ValueError("squash message requires a title")
    try:
        overview_start = lines.index("## Overview") + 1
    except ValueError as error:
        raise ValueError("squash message requires a non-empty Overview") from error
    overview_end = next(
        (index for index in range(overview_start, len(lines)) if lines[index].startswith("## ")),
        len(lines),
    )
    overview = "\n".join(lines[overview_start:overview_end]).strip()
    if not overview:
        raise ValueError("squash message requires a non-empty Overview")
    return f"{lines[0]}\n\n{overview}"


def main() -> int:
    """Run the selected message operation."""
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)
    for name in ("lint", "fmt"):
        subparser = subparsers.add_parser(name)
        subparser.add_argument("--pr", action="store_true")
        subparser.add_argument("--hook", action="store_true")
        subparser.add_argument("--base")
        subparser.add_argument("message", type=Path)
    squash_parser = subparsers.add_parser("squash")
    squash_parser.add_argument("message", type=Path)
    args = parser.parse_args()
    if args.command == "fmt":
        format_message(args.message)
        return 0
    if args.command == "squash":
        try:
            print(squash_message(read_message(args.message)))
        except ValueError as error:
            print(f"error: {error}", file=sys.stderr)
            return 1
        return 0
    prefixed_title = None
    # Only this checkout's own setting counts. FILE may be a temp file
    # outside the repository, so look it up from the current directory.
    prefix = git_output("config", "--local", "--get", "msg.titlePrefix")
    if prefix is not None:
        try:
            # Compile the prefix alone first: "KEY-[" is invalid, but compiles
            # once TITLE_RE follows it and would quietly become another rule.
            re.compile(prefix)
            prefixed_title = re.compile(rf"(?:{prefix})?{TITLE_RE.pattern[1:]}")
        except re.error as error:
            repository = git_output("rev-parse", "--show-toplevel") or Path.cwd()
            print(f"msg.titlePrefix in {repository}: invalid regex: {error}")
            return 1
    errors = lint(
        read_message(args.message),
        args.pr,
        args.hook,
        prefixed_title,
        read_changed_paths(args.hook, args.base),
    )
    for error in errors:
        print(error)
    return 1 if errors else 0


if __name__ == "__main__":
    raise SystemExit(main())
