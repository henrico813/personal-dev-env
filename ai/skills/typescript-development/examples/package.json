{
  "name": "typescript-skill-examples",
  "version": "0.0.0",
  "private": true,
  "description": "Worked examples for the typescript-development skill.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc6 -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test",
    "check:package": "npm run build && publint --strict"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
